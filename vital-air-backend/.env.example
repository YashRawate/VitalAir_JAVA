# Copy this file to .env (or set these as real environment variables) and
# fill in real values. NEVER commit an actual .env file or real API keys.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/vitalair
DB_USERNAME=vitalair
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver

# --- Auth ---
# Must be at least 32 characters for HS256.
VITALAIR_JWT_SECRET=abcdefghijklmnopqrstuvwxyzyuiopw
VITALAIR_JWT_EXPIRATION_MS=86400000

# --- Third-party API keys (all optional - the fallback chain degrades
# gracefully if some are missing, same as the original prototype) ---
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
NASA_FIRMS_API_KEY=
OPENAQ_API_KEY=

# --- Misc ---
PORT=8080
SPRING_PROFILES_ACTIVE=prod
